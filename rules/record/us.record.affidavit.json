{
  "id": "us.record.affidavit",
  "kind": "record",
  "jurisdiction": "us",
  "tags": [
    "declaration"
  ],
  "pattern": "\\b(?:[A-Z][A-Za-z'’-]+\\s+)?(?:(?:Supp\\.|Suppl\\.|Second|Reply|Am\\.)\\s+)?Aff\\.(?:\\s+of\\s+(?:[A-Z][A-Za-z.'’-]*\\s+){1,4}?)?\\s*(?:¶¶?\\s*|at\\s+)(?P<pin>[0-9]{1,5}(?:\\s?[-–]\\s?[0-9]{1,5})?)\\b(?:,\\s+(?:Jan|Feb|Mar|Apr|May|June?|July?|Aug|Sept?|Oct|Nov|Dec)\\.?\\s+[0-9]{1,2},\\s+(?:19|20)[0-9]{2})?",
  "reject": [
    "^(?:See|Cf|Compare|But|Accord|Contra|Also|And|Or|The|In|Under|Per|With|From|E\\.g|Our|My|His|Her|Its|Their|Your|This|That|These|Those|A|An|Each|Every|Any|No|Its|Which|Whose)\\b",
    "^(?:App|Ct|Mem)\\b"
  ],
  "reject_before": [
    "(?:App\\.|aff['’]d|Mem\\.)\\s?$",
    "\\b[0-9]{1,4}\\s+(?:[A-Z&][A-Za-z.'’&,]*\\s?){0,6}$"
  ],
  "priority": 55,
  "normalize": "Aff. {pin}",
  "authority_key": "",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "Bluebook B17 / R10.8.3 (court documents and record cites); Indigo Book R24",
    "opened": false,
    "source_url": "",
    "how_to_verify": "Compare with Bluebook Bluepages B17.1 and Indigo Book R24 (https://law.resource.org/pub/us/code/blue/IndigoBook.html); record abbreviations follow the court's own local practice.",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
    "positive": [
      {
        "text": "See Aff. of John Doe ¶¶ 3-4.",
        "spans": [
          [
            4,
            29
          ]
        ]
      },
      {
        "text": "She saw the car. Miller Aff. ¶ 8, Jan. 12, 2015.",
        "spans": [
          [
            17,
            48
          ]
        ],
        "groups": {
          "pin": "8"
        }
      },
      {
        "text": "Compare Aff. ¶ 2 with Supp. Aff. at 5.",
        "spans": [
          [
            8,
            17
          ],
          [
            23,
            38
          ]
        ]
      }
    ],
    "negative": [
      "The affidavit was notarized.",
      "See Miller Aff. generally.",
      "The Aff. was sworn."
    ]
  },
  "measured": {
    "precision": "unmeasured"
  },
  "note": "A named affiant (`Miller Aff. ¶ 8`) is reported by us.record.witness_document (60); this rule adds `Aff. of`, bare and supplemental affidavits."
}
