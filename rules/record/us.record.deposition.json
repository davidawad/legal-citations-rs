{
  "id": "us.record.deposition",
  "kind": "record",
  "jurisdiction": "us",
  "tags": [
    "transcript"
  ],
  "pattern": "\\b(?:(?P<name>[A-Z][A-Za-z'’-]+)\\s+Dep\\.(?:\\s+Tr\\.)?|Dep(?:\\.|osition)(?:\\s+Tr\\.)?\\s+of\\s+(?P<deponent>(?:[A-Z][A-Za-z.'’-]*\\s+){1,4}?)|Dep\\.\\s+Tr\\.)\\s*,?\\s*(?:at\\s+)?(?P<pin>[0-9]{1,5}(?::[0-9]{1,2})?(?:\\s?[-–]\\s?[0-9]{1,5}(?::[0-9]{1,2})?)?)\\b(?:,\\s+(?:Jan|Feb|Mar|Apr|May|June?|July?|Aug|Sept?|Oct|Nov|Dec)\\.?\\s+[0-9]{1,2},\\s+(?:19|20)[0-9]{2})?",
  "reject": [
    "^(?:See|Cf|Compare|But|Accord|Contra|Also|And|Or|The|In|Under|Per|With|From|E\\.g|Our|My|His|Her|Its|Their|Your|This|That|These|Those|A|An|Each|Every|Any|No|Its|Which|Whose)\\b"
  ],
  "reject_before": [
    "\\b[0-9]{1,4}\\s+(?:[A-Z&][A-Za-z.'’&,]*\\s?){0,6}$"
  ],
  "priority": 56,
  "normalize": "{name}{deponent} Dep. {pin}",
  "authority_key": "",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "Bluebook B17 / R10.8.3 (court documents and record cites); Indigo Book R24",
    "opened": false,
    "source_url": "",
    "how_to_verify": "Compare with Bluebook Bluepages B17.1 and Indigo Book R24 (https://law.resource.org/pub/us/code/blue/IndigoBook.html); record abbreviations follow the court's own local practice.",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
    "positive": [
      {
        "text": "See Dep. of Jane Roe at 12:3.",
        "spans": [
          [
            4,
            28
          ]
        ]
      },
      {
        "text": "She admitted it. Sanchez Dep. 1:1–2, Jan. 3, 2005.",
        "spans": [
          [
            17,
            51
          ]
        ],
        "groups": {
          "name": "Sanchez",
          "pin": "1:1–2"
        }
      },
      {
        "text": "Compare Smith Dep. Tr. at 45 with Dep. Tr. 45:2-9.",
        "spans": [
          [
            8,
            28
          ],
          [
            34,
            49
          ]
        ]
      }
    ],
    "negative": [
      "The deposition of Jane Roe was taken.",
      "See Smith Dep. passim.",
      "Dep. of Transp. issued a memo."
    ]
  },
  "measured": {
    "precision": "unmeasured"
  },
  "note": "A named deponent (`Sanchez Dep. 1:1`) is reported by us.record.witness_document (60); this rule adds `Dep. of`, `Dep. Tr.` and `Smith Dep. Tr.`."
}
