{
  "id": "us.record.witness_document",
  "kind": "record",
  "jurisdiction": "us",
  "pattern": "\\b(?P<witness>[A-Z][a-z]+(?:-[A-Z][a-z]+)?)\\s+(?P<doc>Aff\\.|Decl\\.|Dep\\.)\\s+(?:at\\s+)?(?P<pin>¶¶?\\s?[0-9]{1,4}(?:\\s?[–-]\\s?[0-9]{1,4})?|[0-9]{1,4}(?::[0-9]{1,2})?(?:\\s?[–-]\\s?[0-9]{1,4}(?::[0-9]{1,2})?)?)\\b(?:,\\s(?P<date>(?:Jan|Feb|Mar|Apr|May|June?|July?|Aug|Sept?|Oct|Nov|Dec)\\.?\\s[0-9]{1,2},\\s(?:19|20)[0-9]{2}))?(?:,\\s(?P<ecf>ECF\\s+No\\.\\s?[0-9]{1,5}))?",
  "priority": 60,
  "normalize": "{witness} {doc} {pin}",
  "authority_key": "",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "reject": [
    "^(?:The|See|In|At|Am|And|Under|Per|By|From|With|Each|This|That|Its|Their)\\s"
  ],
  "provenance": {
    "encodes": "The Indigo Book, R24 (Citing Court or Litigation Documents from Your Case)",
    "opened": true,
    "source_url": "https://law.resource.org/pub/us/code/blue/IndigoBook.html",
    "how_to_verify": "Open the Indigo Book (https://law.resource.org/pub/us/code/blue/IndigoBook.html, CC0), R24 (Citing Court or Litigation Documents from Your Case), and compare the form and examples with this pattern.",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
    "positive": [
      {
        "text": "Miller Aff. ¶ 8, Jan. 12, 2015.",
        "spans": [
          [
            0,
            31
          ]
        ],
        "groups": {
          "witness": "Miller",
          "doc": "Aff.",
          "pin": "¶ 8",
          "date": "Jan. 12, 2015"
        }
      },
      {
        "text": "Sanchez Dep. 1:1–2, Jan. 3, 2005, ECF No. 8.",
        "spans": [
          [
            0,
            45
          ]
        ]
      },
      {
        "text": "See Woodmansee Decl. at 7 and Lopez-Ruiz Aff. ¶¶ 3–4.",
        "spans": [
          [
            4,
