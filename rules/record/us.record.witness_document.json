          ],
          [
            30,
            56
          ]
        ]
      }
    ],
    "negative": [
      "Miller Aff. was signed in 2015.",
      "The Sanchez Dep. notice issued 3 days late.",
      "The Decl. 5 form is blank."
    ]
  },
  "measured": {
    "precision": "unmeasured"
  },
  "note": ""
}
