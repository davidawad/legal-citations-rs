  "pattern": "\\b(?P<title>[0-9]{1,2})\\s+C\\.?\\s?F\\.?\\s?R\\.?\\s*(?:(?:§§?|[Pp]arts?|[Ss]ec(?:tion)?\\.?)\\s*)?(?P<section>[0-9]+(?:\\.[0-9]+[a-z]?)*)(?P<subsection>(?:\\([0-9A-Za-z]{1,6}\\))*)",
