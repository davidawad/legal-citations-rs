  "provenance": {
    "encodes": "Indigo Book R30 (Full Citation for Journals, Magazines & Newspaper Articles) and Indigo Book R32.2 (print source with parallel URL) applied to online companions (Harv. L. Rev. F., Yale L.J.F., Colum. L. Rev. Online, Stan. L. Rev. Online, U. Pa. L. Rev. Online)",
    "opened": true,
