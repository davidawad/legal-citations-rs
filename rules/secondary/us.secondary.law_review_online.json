  "pattern": "\\b(?P<volume>[0-9]{1,4})\\s+(?P<journal>(?:(?:[A-Z][A-Za-z'’.-]*|&|of|on|in|for|and|the)\\s){0,8}(?:L\\.\\s?(?:Rev|J)\\.|L\\.J\\.)\\s?(?:F\\.|Forum|Online|Sidebar|Bull\\.|Pocket\\s+Part|In\\s+Brief|Dialogue|Discourse|Headnotes))\\s+(?P<page>[0-9]{1,5})\\b(?:,\\s+(?P<pin>[0-9]{1,5}(?:[-–][0-9]{1,5})?)\\b)?(?:\\s+\\((?P<year>(?:1[5-9][0-9]{2}|20[0-9]{2}))\\)(?:,\\s+(?P<url>https?://[^\\s<>()\\[\\]]*[^\\s<>()\\[\\].,;:]))?)?",
