  "kind": "agency_decision",
  "jurisdiction": "us.fed.sec",
  "pattern": "\\b(?P<doc>Annual\\s+Report|Quarterly\\s+Report|Current\\s+Report|Proxy\\s+Statement|Registration\\s+Statement|Prospectus|Information\\s+Statement|Tender\\s+Offer\\s+Statement)\\s+\\((?P<form>Form\\s+(?:10-K|10-Q|8-K|S-1|S-3|S-4|S-8|F-1|20-F|40-F|6-K|DEF\\s14A|N-CSR)|Schedule\\s+(?:14A|14C|13D|13G|TO))\\)(?:,\\s+at\\s+(?P<page>[0-9]{1,4}))?",
  "priority": 60,
  "normalize": "{doc} ({form})",
  "authority_key": "",
