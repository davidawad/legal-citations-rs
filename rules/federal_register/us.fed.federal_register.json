{
  "id": "us.fed.federal_register",
  "kind": "federal_register",
  "jurisdiction": "us.fed",
  "pattern": "\\b(?P<volume>[0-9]{1,3})\\s+Fed\\.\\s?Reg\\.?\\s+(?P<page>[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{1,6})(?:\\s?[-–‒—]\\s?(?P<page_end>[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{1,6}))?\\b(?:,\\s(?P<pin>[0-9]{1,6}(?:[-–][0-9]{1,6})?)(?:\\s\\([^()]{0,40}?(?:1[6-9]|20)[0-9]{2}\\)|$))?",
  "priority": 60,
  "normalize": "{volume} Fed. Reg. {page}",
  "authority_key": "us.fr/{volume}/{page|digits}",
  "url_templates": [
    "https://www.govinfo.gov/link/fr/{volume}/{page|digits}"
  ],
  "url_decoders": [
    "federalregister.gov/citation/{volume}-FR-{page}",
    "govinfo.gov/link/fr/{volume}/{page}"
  ],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "Bluebook R. 14.2(a) (Federal Register) (21st ed.)",
    "opened": false,
    "source_url": "",
    "how_to_verify": "Open Bluebook R. 14.2(a).",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
