{
  "id": "foreign.au.law_reports",
  "kind": "foreign",
  "jurisdiction": "foreign.au",
  "tags": [
    "foreign",
    "australia"
  ],
  "pattern": "\\((?P<year>(?:18|19|20)[0-9]{2})\\)\\s+(?P<volume>[0-9]{1,3})\\s+(?P<reporter>CLR|ALR|ALJR|FCR|FLR|NSWLR|VR|Qd\\s?R|WAR|SASR|Tas\\s?R|ACTR|NTR|ACSR|IPR|IR|A\\s?Crim\\s?R|ATC|ATR|MVR|ACLC|ACLR)\\s+(?P<page>[0-9]{1,5})\\b(?:,\\s+(?P<pin>[0-9]{1,5}))?",
  "priority": 60,
  "normalize": "({year}) {volume} {reporter} {page}",
  "authority_key": "au.report/{reporter}/{volume}/{page}",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "AGLC (4th ed.) 2.2 (reported decisions: (<year>) <vol> <report series> <page>, <pin>) and appendix (report series abbreviations)",
    "opened": false,
    "source_url": "",
    "how_to_verify": "Open the Australian Guide to Legal Citation (4th ed.) rules 2.1-2.3 and 3.1, and Bluebook T2 (Australia).",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
    "positive": [
      {
        "text": "Mabo v Queensland (No 2) (1992) 175 CLR 1.",
        "spans": [[25, 41]],
        "groups": {
          "year": "1992",
          "volume": "175",
          "reporter": "CLR",
          "page": "1"
        }
      },
      {
        "text": "Love v Commonwealth (2020) 270 CLR 152, 170.",
        "spans": [[20, 43]]
      },
      {
        "text": "R v Tang (2008) 237 CLR 1; see also (2006) 230 ALR 412.",
        "spans": [[9, 25], [36, 54]]
      },
      {
        "text": "(1990) 20 NSWLR 1.",
        "spans": [[0, 17]]
      }
    ],
    "negative": [
      "(1992) saw 175 CLR staff.",
      "The VR headset cost 270 dollars.",
      "(2020) 270 people came."
    ]
  },
  "measured": {
    "precision": "unmeasured"
  },
  "note": "Australian series printed with a round-bracket year; a bare `175 CLR 1` without the year is not matched."
}
