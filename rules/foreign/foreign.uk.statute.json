  "authority_key": "uk.act/{title}/{year}",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "OSCOLA (4th ed.) 2.4 (UK primary legislation: <Short Title> Act <year>, s <n>) and Bluebook T2 (United Kingdom: <title> Act <year>, c. <n>, § <n> (UK))",
    "opened": false,
