  "pattern": "\\b(?P<title>[A-Z][A-Za-z'’-]*(?:\\s+(?:[A-Z][A-Za-z'’-]*|\\([A-Z][A-Za-z'’ .-]{0,40}\\)|of|and|the|for|to|on|in|&)){0,10}\\s+Act)\\s+(?P<year>1[2-9][0-9]{2}|20[0-9]{2})(?:,\\s+(?:c|ch)\\.?\\s+(?P<chapter>[0-9]{1,3}))?(?:,?\\s+(?:§§?|ss?\\.?|sch\\.?|Sch\\.?|pt\\.?|Pt\\.?)\\s*(?P<section>[0-9]{1,4}[A-Z]{0,2}(?:\\([0-9a-z]{1,4}\\))*))?(?P<marker>\\s+\\((?:UK|U\\.K\\.|Eng\\.|Scot\\.|N\\.\\s?Ir\\.|Wales)\\))?",
  "reject": [
    "Act\\s+(?:1[2-9][0-9]{2}|20[0-9]{2})$",
    "^(?:See|Under|In|The|Cf|But|And|Also|Accord|Compare|Contra|Per|Pursuant|Section|Sections|Following|Applying|Unlike|Like|Both|Neither|Its|Their|This|That|These|Those)\\b"
  ],
