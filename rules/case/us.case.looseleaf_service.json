{
  "id": "us.case.looseleaf_service",
  "kind": "case",
  "jurisdiction": "us",
  "pattern": "\\b(?P<volume>[0-9]{1,4}(?:-[0-9])?)\\s+(?P<service>[A-Z][A-Za-z.&’']*(?:\\s+(?:&\\s+)?[A-Z][A-Za-z.&’']*){0,5}?)\\s+\\((?P<publisher>CCH|BNA|P-H|RIA|MB|P\\s?&\\s?F|LRP|Lexis|West)\\)\\s+¶\\s?(?P<para>[0-9]{1,3}(?:,[0-9]{3})?(?:\\.[0-9]{1,3})?)",
  "priority": 55,
  "normalize": "{volume} {service} ({publisher}) ¶ {para}",
  "authority_key": "us.looseleaf/{service}/{volume}/{para}",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "The Indigo Book, T4 (Required Abbreviations for Services) and R19 looseleaf citation",
    "opened": true,
    "source_url": "https://law.resource.org/pub/us/code/blue/IndigoBook.html",
    "how_to_verify": "Open the Indigo Book (https://law.resource.org/pub/us/code/blue/IndigoBook.html, CC0), T4 (Required Abbreviations for Services) and R19 looseleaf citation, and compare the form and examples with this pattern.",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
