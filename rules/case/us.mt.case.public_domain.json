{
  "id": "us.mt.case.public_domain",
  "kind": "case",
  "jurisdiction": "us.mt",
  "pattern": "\\b(?P<year>(?:199[89]|20[0-9]{2}))\\s+MT\\s+(?P<number>[0-9]{1,3})(?P<suffix>[NWA])?\\b",
  "priority": 65,
  "normalize": "{year} MT {number}",
  "authority_key": "us.mt.public_domain/{year}/{number}",
  "url_templates": [],
  "url_decoders": [],
  "base_confidence": 0.9,
  "provenance": {
    "encodes": "Montana Supreme Court orders of Dec. 16, 1997, Jan. 22, 2009 and Feb. 25, 2010 on citing cases (year, MT, number from 1998; N, W and A suffixes)",
    "opened": true,
    "source_url": "https://courts.mt.gov/external/library/docs/cite_cases.pdf",
    "how_to_verify": "",
    "derived_from": [],
    "third_party": []
  },
  "examples": {
    "positive": [
      {
        "text": "Doe v. Roe, 1998 MT 12, ¶¶ 44-45, 286 Mont. 175.",
        "spans": [[12, 22]],
        "groups": {
          "year": "1998",
          "number": "12"
        }
      },
      {
        "text": "See State v. Smith, 2013 MT 45, ¶ 9.",
        "spans": [[20, 30]]
      },
      {
        "text": "Jones v. Brown, 1998 MT 1N.",
        "spans": [[16, 26]]
      }
    ],
    "negative": [
      "Highway MT 12 was closed in 1998.",
      "In 2013 Montana had 45 new towns.",
      "The 2013 MT Fair drew 45 thousand visitors.",
      "She left MT in 2013 after 4 years."
    ]
  },
  "measured": {
    "precision": "unmeasured"
  },
  "note": "Public-domain (vendor-neutral) citation; the span is the citation core only, so a pinpoint paragraph and a parallel reporter cite stay outside it. No URL template: no fetch-verified host decodes this form yet."
}
