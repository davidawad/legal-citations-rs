{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JsonReport",
  "description": "`--format json`.",
  "type": "object",
  "properties": {
    "files": {
      "description": "Per-file results.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/JsonFile"
      }
    },
    "header": {
      "description": "Header.",
      "$ref": "#/$defs/Header"
    },
    "summary": {
      "description": "Summary.",
      "$ref": "#/$defs/Summary"
    }
  },
  "required": [
    "header",
    "files",
    "summary"
  ],
  "$defs": {
    "AgencyDetails": {
      "description": "Typed fields of an agency document.",
      "type": "object",
      "properties": {
        "agency": {
          "description": "Agency, from the rule's jurisdiction (`USPTO`, `IRS`), if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "description": "Date or year, when cited.",
          "type": [
            "string",
            "null"
          ]
        },
        "document_type": {
          "description": "Document type as written (`MPEP`, `Rev. Rul.`, `IPR`, `Fed. Reg.`).",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "Document number or section.",
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "description": "Page (Federal Register).",
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "description": "Volume (Federal Register).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Binding": {
      "description": "A citation-to-link binding.",
      "type": "object",
      "properties": {
        "link": {
          "description": "Index into [`Document::links`].",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "via": {
          "description": "How the citation reaches the link.",
          "$ref": "#/$defs/Via"
        }
      },
      "required": [
        "link",
        "via"
      ]
    },
    "CaseDetails": {
      "description": "Typed case fields.",
      "type": "object",
      "properties": {
        "case_name": {
          "description": "Case name (shared by every cite of a parallel group).",
          "type": [
            "string",
            "null"
          ]
        },
        "court": {
          "description": "Court from the date parenthetical.",
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "description": "Full date when the parenthetical has one (`Sept. 10, 2002`).",
          "type": [
            "string",
            "null"
          ]
        },
        "history_of": {
          "description": "On a later decision cited as history: index of the earlier one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "number": {
          "description": "Database or public-domain number (`2001 WL 12345`, `2025-Ohio-2425`).",
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "description": "First page.",
          "type": [
            "string",
            "null"
          ]
        },
        "parallel_of": {
          "description": "On a parallel cite: index of the first cite of its group.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "parallels": {
          "description": "On the first cite of a parallel group: the other cites.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "parties": {
          "description": "Parties parsed from the case name.",
          "anyOf": [
            {
              "$ref": "#/$defs/Parties"
            },
            {
              "type": "null"
            }
          ]
        },
        "pincites": {
          "description": "Pincites, one per comma-separated pin (`389-90`, `*3`, `5 n.2`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reporter": {
          "description": "Reporter as written.",
          "type": [
            "string",
            "null"
          ]
        },
        "reporter_canonical": {
          "description": "Reporter with Bluebook spacing (`F. Supp. 2d`, `N.E.2d`, `S. Ct.`).",
          "type": [
            "string",
            "null"
          ]
        },
        "subsequent_history": {
          "description": "Subsequent history of this decision (`aff'd`, `cert. denied`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/History"
          }
        },
        "volume": {
          "description": "Reporter volume.",
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "description": "Decision year.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pincites",
        "parallels",
        "subsequent_history"
      ]
    },
    "Citation": {
      "description": "A detected citation. All spans index the ORIGINAL text.",
      "type": "object",
      "properties": {
        "antecedent": {
          "description": "Index (in the returned vector) of the citation a short form refers to.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "authority": {
          "description": "Canonical authority identity; short forms inherit their antecedent's.",
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "description": "Confidence in `[0, 1]`.",
          "type": "number",
          "format": "double"
        },
        "confidence_terms": {
          "description": "Each term of the confidence calculation, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        },
        "core_span": {
          "description": "Exactly what the rule matched.",
          "$ref": "#/$defs/Span"
        },
        "details": {
          "description": "Typed fields by shape: case parts, parallel cites and subsequent\nhistory; code, title, sections; agency, document type, number.",
          "$ref": "#/$defs/Details"
        },
        "fields": {
          "description": "Named fields: rule groups plus `case_name`, `pincite`, `court`, `year`.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "full_span": {
          "description": "Signal through explanatory parenthetical.",
          "$ref": "#/$defs/Span"
        },
        "furniture": {
          "description": "Set when the citation is page furniture (running head, repeated\ncaption); the link policy does not require a link on it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Furniture"
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "description": "Dotted jurisdiction: the court's, when the court parenthetical names\none the court table knows (`(Ohio Ct. App. 2010)` is `us.oh`), else\nthe rule's. A resolved short form has its antecedent's.",
          "type": "string"
        },
        "kind": {
          "description": "Citation kind.",
          "$ref": "#/$defs/Kind"
        },
        "normalized": {
          "description": "Display form from the rule's `normalize` template.",
          "type": "string"
        },
        "parenthetical": {
          "description": "Explanatory parenthetical after the citation.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "description": "Id of the rule that matched (`cite-detect explain <rule_id>`).",
          "type": "string"
        },
        "rule_jurisdiction": {
          "description": "Dotted jurisdiction of the rule that matched.",
          "type": "string"
        },
        "signal": {
          "description": "Signal preceding the citation (`See`, `Cf.`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "The citation proper: case name (if any) through the closing date\nparenthetical. Link status is decided on this span.",
          "$ref": "#/$defs/Span"
        },
        "text": {
          "description": "Text of `span`.",
          "type": "string"
        },
        "urls": {
          "description": "Candidate source URLs from the rule's verified `url_templates` (a\nresolved short form inherits its antecedent's).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified_rule": {
          "description": "True when the rule's encoded authority was actually opened.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "rule_id",
        "span",
        "core_span",
        "full_span",
        "text",
        "fields",
        "jurisdiction",
        "rule_jurisdiction",
        "normalized",
        "confidence",
        "confidence_terms",
        "verified_rule",
        "details",
        "urls"
      ]
    },
    "CodeDetails": {
      "description": "Typed fields of a codified provision.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The code as written (`U.S.C.`, `Ohio Rev. Code`, `Fed. R. Civ. P.`).",
          "type": [
            "string",
            "null"
          ]
        },
        "edition": {
          "description": "Edition or publisher from the parenthetical (`West`), or an edition group.",
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "description": "Sections or rules cited, without subsections.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subsections": {
          "description": "Subsection path of the first section: `(a)(1)(B)` is `[\"a\", \"1\", \"B\"]`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "description": "Title or volume (`28` in `28 U.S.C.`).",
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "description": "Year from a code parenthetical (`(2018)`) or the rule's year group.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sections",
        "subsections"
      ]
    },
    "Details": {
      "description": "Typed fields of a citation, by shape.",
      "oneOf": [
        {
          "description": "A case or short case cite.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "case"
            }
          },
          "$ref": "#/$defs/CaseDetails",
          "required": [
            "type"
          ]
        },
        {
          "description": "A codified provision: statute, regulation, constitution, court rule,\nsession law.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            }
          },
          "$ref": "#/$defs/CodeDetails",
          "required": [
            "type"
          ]
        },
        {
          "description": "An agency document: Federal Register, manual, decision, ruling.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agency"
            }
          },
          "$ref": "#/$defs/AgencyDetails",
          "required": [
            "type"
          ]
        },
        {
          "description": "`Id.` or `supra`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "short"
            }
          },
          "$ref": "#/$defs/ShortDetails",
          "required": [
            "type"
          ]
        },
        {
          "description": "Record, docket, secondary, treaty, foreign, unrecognized: see `fields`.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "Document": {
      "description": "The L4 result.",
      "type": "object",
      "properties": {
        "bindings": {
          "description": "Per citation (same index), its link bindings.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Binding"
            }
          }
        },
        "citations": {
          "description": "Citations in text order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "format": {
          "description": "Input format.",
          "$ref": "#/$defs/Format"
        },
        "links": {
          "description": "Links in source order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "suppressions": {
          "description": "Inline suppressions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Suppression"
          }
        },
        "zones": {
          "description": "Masked regions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zone"
          }
        }
      },
      "required": [
        "format",
        "citations",
        "links",
        "bindings",
        "zones",
        "suppressions"
      ]
    },
    "Finding": {
      "description": "One finding.",
      "type": "object",
      "properties": {
        "citation": {
          "description": "Citation index in the document, if any.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "code": {
          "description": "Stable code.",
          "type": "string"
        },
        "fix": {
          "description": "Fix, when one can be built.",
          "anyOf": [
            {
              "$ref": "#/$defs/Fix"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "Kind of the citation.",
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "description": "Link destination involved.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human message.",
          "type": "string"
        },
        "name": {
          "description": "Code name.",
          "type": "string"
        },
        "rule_id": {
          "description": "Rule that detected the citation.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "Severity after policy overrides.",
          "$ref": "#/$defs/Severity"
        },
        "span": {
          "description": "Where (the citation span; for suppressions, the comment).",
          "$ref": "#/$defs/Span"
        },
        "suppressed": {
          "description": "True when an inline suppression covered this finding.",
          "type": "boolean"
        },
        "text": {
          "description": "Citation text.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "severity",
        "message",
        "span",
        "text",
        "suppressed"
      ]
    },
    "Fix": {
      "description": "A machine-applicable or suggested fix.",
      "type": "object",
      "properties": {
        "replacement": {
          "description": "Replacement text.",
          "type": "string"
        },
        "safe": {
          "description": "True only when the URL comes from a template of a rule whose encoded\nauthority was opened; `cite-detect fix --apply` applies only these.",
          "type": "boolean"
        },
        "span": {
          "description": "Bytes to replace.",
          "$ref": "#/$defs/Span"
        },
        "url": {
          "description": "Suggested URL.",
          "type": "string"
        }
      },
      "required": [
        "span",
        "replacement",
        "url",
        "safe"
      ]
    },
    "Format": {
      "description": "Input format.",
      "oneOf": [
        {
          "description": "Plain text: no links, nothing masked.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "CommonMark + GFM tables/footnotes + front matter.",
          "type": "string",
          "const": "markdown"
        }
      ]
    },
    "Furniture": {
      "description": "Why a citation is page furniture rather than a cite in the prose.",
      "oneOf": [
        {
          "description": "A slip-opinion running head: `Cite as: 606 U. S. 656 (2025)`.",
          "type": "string",
          "const": "running_head"
        },
        {
          "description": "A citation alone on a line that recurs verbatim, such as a PTAB\ncaption (`IPR2025-00687`) repeated on every page.",
          "type": "string",
          "const": "repeated_caption"
        }
      ]
    },
    "Header": {
      "description": "First record: what produced the report.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "`detect` or `lint`.",
          "type": "string"
        },
        "policy_hash": {
          "description": "Hash of the effective policy.",
          "type": "string"
        },
        "registry_hash": {
          "description": "Hash of the embedded rule registry.",
          "type": "string"
        },
        "schema": {
          "description": "`cite-detect.report/1`.",
          "type": "string"
        },
        "type": {
          "description": "Always `header`.",
          "type": "string"
        },
        "version": {
          "description": "Tool version.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "schema",
        "version",
        "registry_hash",
        "policy_hash",
        "mode"
      ]
    },
    "History": {
      "description": "One subsequent-history step: `aff'd, 123 F.3d 456`.",
      "type": "object",
      "properties": {
        "citation": {
          "description": "Index of the citation of the later decision.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "phrase": {
          "description": "The history phrase as written (`aff'd`, `cert. denied`).",
          "type": "string"
        }
      },
      "required": [
        "phrase",
        "citation"
      ]
    },
    "JsonFile": {
      "description": "One file in the JSON report.",
      "type": "object",
      "properties": {
        "document": {
          "description": "The document (citations, links, bindings, zones, suppressions).",
          "$ref": "#/$defs/Document"
        },
        "file": {
          "description": "Input label.",
          "type": "string"
        },
        "findings": {
          "description": "Findings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "file",
        "document",
        "findings"
      ]
    },
    "Kind": {
      "description": "Closed citation-kind taxonomy. Extending it is a code change on purpose:\npolicy, findings and consumers all switch on it.",
      "oneOf": [
        {
          "description": "Full case citation: volume, reporter, page.",
          "type": "string",
          "const": "case"
        },
        {
          "description": "Short case citation: `449 U.S. at 389`.",
          "type": "string",
          "const": "case_short"
        },
        {
          "description": "`Id.` / `Ibid.`",
          "type": "string",
          "const": "id"
        },
        {
          "description": "`Smith, supra`",
          "type": "string",
          "const": "supra"
        },
        {
          "description": "Codified statute (U.S.C., state codes).",
          "type": "string",
          "const": "statute"
        },
        {
          "description": "Session law (Pub. L., Stat.).",
          "type": "string",
          "const": "session_law"
        },
        {
          "description": "Codified regulation (C.F.R., state administrative codes).",
          "type": "string",
          "const": "regulation"
        },
        {
          "description": "Federal Register.",
          "type": "string",
          "const": "federal_register"
        },
        {
          "description": "Constitution.",
          "type": "string",
          "const": "constitution"
        },
        {
          "description": "Court rule (FRCP, FRAP, FRE, circuit and local rules).",
          "type": "string",
          "const": "court_rule"
        },
        {
          "description": "Agency manual (MPEP, TBMP, TMEP).",
          "type": "string",
          "const": "agency_manual"
        },
        {
          "description": "Agency decision or ruling (Rev. Rul., PTAB/TTAB decisions).",
          "type": "string",
          "const": "agency_decision"
        },
        {
          "description": "Record cite (ER-139, JA 16, Ex. 1001, TTABVUE, ECF No.).",
          "type": "string",
          "const": "record"
        },
        {
          "description": "Secondary source (Restatement, treatise, law review).",
          "type": "string",
          "const": "secondary"
        },
        {
          "description": "Treaty.",
          "type": "string",
          "const": "treaty"
        },
        {
          "description": "Foreign authority.",
          "type": "string",
          "const": "foreign"
        },
        {
          "description": "Docket number.",
          "type": "string",
          "const": "docket"
        },
        {
          "description": "Legislative material (bills, committee reports, Cong. Rec., hearings, CRS reports).",
          "type": "string",
          "const": "legislative"
        },
        {
          "description": "Executive material (executive orders, proclamations, presidential memoranda).",
          "type": "string",
          "const": "executive"
        },
        {
          "description": "Short statute or regulation citation by section alone: `§ 1983`.",
          "type": "string",
          "const": "statute_short"
        },
        {
          "description": "Citation-shaped text no specific rule matched (catch-all layer,\nconfidence below 0.5, finding CITE011).",
          "type": "string",
          "const": "unrecognized"
        }
      ]
    },
    "Link": {
      "description": "A link in the document.",
      "type": "object",
      "properties": {
        "dest": {
          "description": "Destination as written (reference links resolved).",
          "type": "string"
        },
        "footnote": {
          "description": "Footnote label when the link sits inside a footnote definition.",
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "description": "Whole link source, delimiters included.",
          "$ref": "#/$defs/Span"
        },
        "style": {
          "description": "Syntax used.",
          "$ref": "#/$defs/LinkStyle"
        },
        "text_span": {
          "description": "The visible link text.",
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "span",
        "text_span",
        "dest",
        "style"
      ]
    },
    "LinkStyle": {
      "description": "How a link was written.",
      "oneOf": [
        {
          "description": "`[text](dest)`",
          "type": "string",
          "const": "inline"
        },
        {
          "description": "`[text][ref]`, `[text][]`, `[text]` with a definition",
          "type": "string",
          "const": "reference"
        },
        {
          "description": "`<https://...>`",
          "type": "string",
          "const": "autolink"
        },
        {
          "description": "`<a href=\"...\">text</a>`",
          "type": "string",
          "const": "html"
        }
      ]
    },
    "Parties": {
      "description": "The parties of a case name.",
      "type": "object",
      "properties": {
        "first": {
          "description": "First-named party (`versus` style).",
          "type": [
            "string",
            "null"
          ]
        },
        "second": {
          "description": "Second-named party (`versus` style).",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "description": "Naming style.",
          "$ref": "#/$defs/PartyStyle"
        },
        "subject": {
          "description": "The subject of an `In re` or `Ex parte` name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "style"
      ]
    },
    "PartyStyle": {
      "description": "How the parties of a case are named.",
      "oneOf": [
        {
          "description": "`First v. Second`.",
          "type": "string",
          "const": "versus"
        },
        {
          "description": "`In re Subject`.",
          "type": "string",
          "const": "in_re"
        },
        {
          "description": "`Ex parte Subject`.",
          "type": "string",
          "const": "ex_parte"
        }
      ]
    },
    "Severity": {
      "description": "Finding severity, ordered.",
      "oneOf": [
        {
          "description": "Inventory or heuristic note; never fails by default.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Should be fixed.",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "Must be fixed.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "ShortDetails": {
      "description": "Fields of `Id.` and `supra`.",
      "type": "object",
      "properties": {
        "pincites": {
          "description": "Pincites.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "pincites"
      ]
    },
    "Span": {
      "description": "A located range of the original input.",
      "type": "object",
      "properties": {
        "char_end": {
          "description": "Exclusive end, Unicode scalar values.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "char_start": {
          "description": "Inclusive start, Unicode scalar values.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "col": {
          "description": "1-based column of `start`, in Unicode scalar values.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "end": {
          "description": "Exclusive end, UTF-8 bytes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "end_col": {
          "description": "1-based column of `end`, in Unicode scalar values.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "end_line": {
          "description": "1-based line of `end`.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "line": {
          "description": "1-based line of `start`.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "start": {
          "description": "Inclusive start, UTF-8 bytes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "utf16_end": {
          "description": "Exclusive end, UTF-16 code units.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "utf16_start": {
          "description": "Inclusive start, UTF-16 code units (editor/LSP positions).",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "char_start",
        "char_end",
        "utf16_start",
        "utf16_end",
        "line",
        "col",
        "end_line",
        "end_col"
      ]
    },
    "Summary": {
      "description": "Last record: counts and the verdict.",
      "type": "object",
      "properties": {
        "by_code": {
          "description": "Unsuppressed findings by code.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "by_kind": {
          "description": "Citations by kind.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "by_rule": {
          "description": "Citations by rule.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "citations": {
          "description": "Citations detected.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "files": {
          "description": "Files read.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "linked": {
          "description": "Citations with at least one link.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "passed": {
          "description": "False when an unsuppressed finding reached `--fail-on`.",
          "type": "boolean"
        },
        "suppressed": {
          "description": "Findings covered by a suppression comment.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "type": {
          "description": "Always `summary`.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "files",
        "citations",
        "linked",
        "by_code",
        "by_kind",
        "by_rule",
        "suppressed",
        "passed"
      ]
    },
    "Suppression": {
      "description": "An inline suppression comment:\n`<!-- cite-detect: ignore CITE001 reason=\"...\" -->`.",
      "type": "object",
      "properties": {
        "codes": {
          "description": "Finding codes suppressed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "Mandatory reason (empty means malformed).",
          "type": "string"
        },
        "scope": {
          "description": "`next` (the next line) or `file`.",
          "type": "string"
        },
        "span": {
          "description": "Where the comment is.",
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "codes",
        "reason",
        "scope",
        "span"
      ]
    },
    "Term": {
      "description": "One step of the confidence calculation.",
      "oneOf": [
        {
          "description": "Add (or subtract) a value.",
          "type": "object",
          "properties": {
            "add": {
              "type": "object",
              "properties": {
                "label": {
                  "description": "Why.",
                  "type": "string"
                },
                "value": {
                  "description": "Amount.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "add"
          ]
        },
        {
          "description": "Cap the final value.",
          "type": "object",
          "properties": {
            "cap": {
              "type": "object",
              "properties": {
                "label": {
                  "description": "Why.",
                  "type": "string"
                },
                "value": {
                  "description": "Ceiling.",
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "label",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "cap"
          ]
        }
      ]
    },
    "Via": {
      "description": "How a citation is tied to a link.",
      "oneOf": [
        {
          "description": "The link text covers (part of) the citation.",
          "type": "string",
          "const": "direct"
        },
        {
          "description": "A footnote reference right after the citation points to a definition\nthat contains the link.",
          "type": "string",
          "const": "footnote"
        }
      ]
    },
    "Zone": {
      "description": "A region excluded from detection.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/ZoneKind"
        },
        "span": {
          "description": "Where.",
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "kind",
        "span"
      ]
    },
    "ZoneKind": {
      "description": "What a masked zone was.",
      "oneOf": [
        {
          "description": "YAML/TOML front matter.",
          "type": "string",
          "const": "front_matter"
        },
        {
          "description": "Fenced or indented code, or inline code.",
          "type": "string",
          "const": "code"
        },
        {
          "description": "HTML block, inline HTML, comment.",
          "type": "string",
          "const": "html"
        },
        {
          "description": "Link destination, title, brackets.",
          "type": "string",
          "const": "link_syntax"
        },
        {
          "description": "Reference-link definition line.",
          "type": "string",
          "const": "link_definition"
        },
        {
          "description": "Footnote reference or label.",
          "type": "string",
          "const": "footnote_label"
        }
      ]
    }
  }
}
